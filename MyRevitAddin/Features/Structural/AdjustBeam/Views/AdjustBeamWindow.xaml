<Window x:Class="MyRevitAddin.Features.Structural.AdjustBeam.Views.AdjustBeamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MyRevitAddin.Features.Structural.AdjustBeam.ViewModels"
        mc:Ignorable="d"
        Title="Adjust structural beam"
        Height="500"
        Width="500"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="{DynamicResource BrushBgWindow}"
        Foreground="{DynamicResource BrushText}"
        FontFamily="{DynamicResource MainFontFamily}"
        d:DataContext="{d:DesignInstance Type=vm:AdjustBeamViewModel, IsDesignTimeCreatable=True}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WPFUI;component/Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="150" />
        </Grid.ColumnDefinitions>

        <!-- Row 0 -->
        <TextBlock Style="{StaticResource TextBlockStyle}"
                   Text="Beam -> Wall clearance (mm)"
                   VerticalAlignment="Center"
                   Margin="0,8" />
        <TextBox Style="{StaticResource TextBoxStyle}"
                 Grid.Column="1"
                 Text="{Binding Config.BeamToWallClearance}"
                 Margin="0,8" />

        <!-- Row 1 -->
        <TextBlock Style="{StaticResource TextBlockStyle}"
                   Grid.Row="1"
                   Text="Beam -> Pillar clearance (mm)"
                   VerticalAlignment="Center"
                   Margin="0,8" />
        <TextBox Style="{StaticResource TextBoxStyle}"
                 Grid.Row="1"
                 Grid.Column="1"
                 Text="{Binding Config.BeamToPillarClearance}"
                 Margin="0,8" />

        <!-- Row 2 -->
        <TextBlock Style="{StaticResource TextBlockStyle}"
                   Grid.Row="2"
                   Text="Beam -> Beam inline gap (mm)"
                   VerticalAlignment="Center"
                   Margin="0,8" />
        <TextBox Style="{StaticResource TextBoxStyle}"
                 Grid.Row="2"
                 Grid.Column="1"
                 Text="{Binding Config.BeamToBeamInlineGap}"
                 Margin="0,8" />

        <!-- Row 3 -->
        <TextBlock Style="{StaticResource TextBlockStyle}"
                   Grid.Row="3"
                   Text="Beam -> Beam perpendicular gap (mm)"
                   VerticalAlignment="Center"
                   Margin="0,8" />
        <TextBox Style="{StaticResource TextBoxStyle}"
                 Grid.Row="3"
                 Grid.Column="1"
                 Text="{Binding Config.BeamToBeamPerpendicularGap}"
                 Margin="0,8" />

        <!-- Row 4 -->
        <TextBlock Style="{StaticResource TextBlockStyle}"
                   Grid.Row="4"
                   Text="Beam corner at pillar"
                   VerticalAlignment="Center"
                   Margin="0,8" />
        <ComboBox Style="{StaticResource ComboBoxStyle}"
                  Grid.Row="4"
                  Grid.Column="1"
                  ItemsSource="{Binding CornerOptions}"
                  SelectedItem="{Binding Config.BeamCornerAtPillar}"
                  Margin="0,8" />

        <!-- Row 5: GroupBox for advanced options -->
        <GroupBox Style="{StaticResource GroupBoxStyle}"
                  Grid.Row="5"
                  Grid.ColumnSpan="2"
                  Header="Advanced Corner Extensions"
                  Margin="0,15,0,0">
            <StackPanel Margin="10">
                <CheckBox Style="{StaticResource CheckBoxStyle}"
                          Content="Corner / T-shape at pillar: extend to beam body"
                          IsChecked="{Binding Config.CornerTShapeAtPillarExtendToBeamBody}"
                          Margin="0,0,0,10" />
                <CheckBox Style="{StaticResource CheckBoxStyle}"
                          Content="Corner at wall: extend to beam body"
                          IsChecked="{Binding Config.CornerAtWallExtendToBeamBody}" />
            </StackPanel>
        </GroupBox>

        <!-- Button -->
        <Button Style="{StaticResource ButtonStyle}"
                Grid.Row="7"
                Grid.Column="1"
                Content="Adjust"
                Command="{Binding AdjustCommand}"
                Margin="4" />
    </Grid>
</Window>
